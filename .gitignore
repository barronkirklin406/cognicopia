/output_pdfs
# resident data must never be committed
payloads/
*.cognicopia
# pages written by scripts/generate_infinite_pages.mjs (default output folder)
/out/
.continue/
new-config.yaml

# generated review sheets for traced art (scripts/review_coloring_art.mjs)
/assets/coloring/_review/

# license-signing keys (scripts/license-keygen.mjs): the private half never goes in the repository
*.pem
*-private.*
license-private*
.cognicopia/

# the outreach desk: real prospect contacts and the send record are never committed (this repository is public)
outreach/data/

# master PNG line art for scripts/build_coloring_svgs.py: not published, not committed (the SVGs it makes are)
/assets/raw_coloring_pngs/

# the local art agent (scripts/local_art_agent.mjs): picture models stay in ~/.cognicopia, never here; no Python caches
*.safetensors
*.ckpt
*.gguf
__pycache__/

# this computer's own permission choices for the coding assistant (never shared)
.claude/settings.local.json

# raw coloring masters (rights not settled): never committed
assets/coloring/_inbox/*.png
assets/coloring/_inbox/*.json

# the owner's n8n workflow is private: kept outside the published repository (docs/n8n-operations.md)
/owner-private/
/n8n-*.json
