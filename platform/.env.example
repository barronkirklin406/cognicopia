# Copy to .env.local and fill in. Never commit real values.
# (From `supabase start` locally, or Project Settings > API in the Supabase dashboard.)

# Safe for the browser: row level security protects the data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Never prefix with NEXT_PUBLIC_, never log it.
SUPABASE_SERVICE_ROLE_KEY=
