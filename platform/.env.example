# Cognicopia platform: every setting the app reads.
#
# Copy this file to .env.local and fill it in. Never commit real values: this
# repository is public, and this file holds placeholders only. On a host such as
# Vercel, enter the same names in the project's environment settings instead.
#
# A setting that is missing or malformed breaks only the feature that needs it, and
# the error names the setting (never its value). Sign-in needs the Supabase group
# and APP_URL; billing needs the Stripe group as well.

# ---------------------------------------------------------------------------
# Supabase: the database and sign-in
# Local: `supabase start` prints these. Hosted: Project Settings > API.
# ---------------------------------------------------------------------------

# Where Supabase is.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The public (anon) key. Safe in a page: row level security protects the data, not
# this key's secrecy. Supabase's newer "publishable" key works here too.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Skips row level security. The server uses it only for what no signed-in
# person may do for themselves: recording a facility's Stripe customer and subscription
# status (when checkout starts, when someone returns from Stripe, and in the webhook).
# Never give it a NEXT_PUBLIC_ prefix, never log it, never paste it into a chat or an issue.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# This app
# ---------------------------------------------------------------------------

# The address people reach this app at: no path, no trailing slash. Local:
# http://127.0.0.1:3000. Production: https://app.cognicopia.org (or wherever it is hosted).
# Stripe sends people back to it after Checkout and after the billing portal, the emails
# Supabase sends link to it, and invitation links begin with it. It is never taken from a
# request header, which a caller could forge.
# Also add <APP_URL>/auth/callback to Supabase's redirect list (Authentication > URL
# Configuration; locally, supabase/config.toml).
APP_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Stripe: subscriptions. SERVER ONLY.
# Use TEST-mode values (Stripe Dashboard with the Test mode switch on) until you
# are ready to take real payments, then swap in the live ones.
# ---------------------------------------------------------------------------

# The secret key: starts with sk_test_ or sk_live_. A restricted key (rk_...) works if it can
# write Customers, Checkout Sessions and Billing Portal Sessions and read Subscriptions.
# Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=

# The signing secret of the webhook endpoint: starts with whsec_. Dashboard > Developers >
# Webhooks > Add endpoint:  <APP_URL>/api/stripe/webhook
# Subscribe it to exactly these events (any others are acknowledged and ignored):
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_failed
#   customer.subscription.created
#   checkout.session.completed
# Locally, the Stripe CLI forwards events and prints the secret to use here:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# The two recurring prices a facility can choose (Dashboard > Product catalog: one
# product, a monthly price and an annual price). Each starts with price_.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional. A saved billing portal configuration (starts with bpc_), from Dashboard >
# Settings > Billing > Customer portal. Leave empty to use Stripe's default one. Whichever
# you use must let customers update their payment method, and, if you want them to, cancel
# or change plan.
STRIPE_PORTAL_CONFIGURATION_ID=

# Optional. A free trial on a new subscription, in days (1 to 90). Leave empty for none: a
# facility then pays when it subscribes. A trial grants full access until it ends.
STRIPE_TRIAL_DAYS=

# ---------------------------------------------------------------------------
# Local testing only
# ---------------------------------------------------------------------------

# Point the Stripe client at a stand-in server (such as Stripe's own stripe-mock, which
# listens on http://localhost:12111) so Checkout and the portal can be tried with no
# account. Ignored when NODE_ENV is production, so it can never redirect live billing.
# STRIPE_API_BASE=http://localhost:12111
